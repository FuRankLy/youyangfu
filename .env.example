# Copy to .env.local and fill in. Never commit real values.
# Where contact form messages are delivered.
CONTACT_TO_EMAIL=
# Sender shown on those emails, e.g. "youyangfu.com <hello@youyangfu.com>" once the domain is verified in Resend.
CONTACT_FROM_EMAIL=
# https://resend.com/api-keys
RESEND_API_KEY=
